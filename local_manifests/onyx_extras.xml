<?xml version="1.0" encoding="UTF-8"?>
<!--
     Copy to .repo/local_manifests/ and run repo sync.
-->
<manifest>
    <remote name="onyx-extras-github" fetch="https://github.com/" />

    <!-- This repository: patches, the ax_* SDK modules and the integration makefiles -->
    <project path="vendor/onyx-extras"
             name="alexssandro56/alexssandro56-android_patches_onyx"
             remote="onyx-extras-github"
             revision="ccr-786c7be0-pn26hi" />

    <!-- GameSpace app, IRedDragonICY -->
    <project path="packages/apps/GameSpace"
             name="IRedDragonICY/GameSpace"
             remote="onyx-extras-github"
             revision="main" />

    <!-- AFME frame generation layers -->
    <project path="external/afme"
             name="IRedDragonICY/afme"
             remote="onyx-extras-github"
             revision="main" />

    <!-- Open-source replacement for mi_thermald -->
    <project path="external/mithermald"
             name="IRedDragonICY/mithermald"
             remote="onyx-extras-github"
             revision="main" />
</manifest>
