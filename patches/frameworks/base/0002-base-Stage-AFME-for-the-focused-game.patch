+    /**
+     * Applies the game's AFME settings and arms the layers for it, or disarms
+     * them when {@code packageName} is null. A layer already loaded in a game
+     * keeps running and follows these properties.
+     */
+    private void stageAfme(String packageName) {
+        try {
+            if (packageName == null) {
+                SystemProperties.set(PROP_AFME_APP, "");
+                SystemProperties.set(PROP_AFME_SESSION, "0");
+                return;
+            }
+            final int multiplier = readPerApp(KEY_AFME_MULTIPLIER).optInt(packageName, 0);
+            final String factor = readPerApp(KEY_AFME_FACTOR).optString(packageName, "auto");
+            final int sgsrMode = readPerApp(KEY_SGSR_MODE).optInt(packageName, 0);
+            final boolean smoothMotion =
+                    readPerApp(KEY_SMOOTH_MOTION).optBoolean(packageName, false);
+            final boolean frameGen = multiplier >= 2;
+            final boolean armed = frameGen || sgsrMode > 0;
+
+            if (frameGen) {
+                SystemProperties.set(PROP_AFME_MULTIPLIER, Integer.toString(multiplier));
+            }
+            SystemProperties.set(PROP_AFME_FG, frameGen ? "1" : "0");
+            SystemProperties.set(PROP_AFME_FACTOR, "auto".equals(factor) ? "" : factor);
+            SystemProperties.set(PROP_SGSR_ENABLE, sgsrMode > 0 ? "1" : "0");
+            SystemProperties.set(PROP_SGSR_MODE, Integer.toString(sgsrMode));
+            SystemProperties.set(PROP_AFME_SMOOTH_MOTION, smoothMotion ? "1" : "0");
+            SystemProperties.set(PROP_AFME_ENABLE, armed ? "1" : "0");
+            SystemProperties.set(PROP_AFME_APP, armed ? packageName : "");
+            SystemProperties.set(PROP_AFME_SESSION, armed ? "1" : "0");
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Failed to stage AFME for " + packageName, e);
+        }
+    }
+
+    private JSONObject readPerApp(String key) {
+        final String json = Settings.System.getStringForUser(mContext.getContentResolver(), key,
+                UserHandle.USER_CURRENT);
+        if (TextUtils.isEmpty(json)) {
+            return new JSONObject();
+        }
+        try {
+            return new JSONObject(json);
+        } catch (JSONException e) {
+            Slog.w(TAG, "Ignoring malformed " + key);
+            return new JSONObject();
+        }
+    }
+
