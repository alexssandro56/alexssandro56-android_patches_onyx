+package com.android.server.wm;
+
+import android.app.ActivityManager;
+import android.app.IActivityManager;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.os.RemoteCallbackList;
+import android.os.RemoteException;
+import android.os.SystemProperties;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.Slog;
+
+import com.android.internal.app.IGameSpaceCallback;
+
+class GameStateDispatcher {
+    private static final String TAG = "GameStateDispatcher";
+    private static final String GAME_SPACE_PACKAGE = "com.ireddragonicy.gamespace";
+    private static final ComponentName GAME_SPACE_SERVICE_COMPONENT = new ComponentName(
+            GAME_SPACE_PACKAGE, GAME_SPACE_PACKAGE + ".gamebar.GameSpaceService");
+    private static final String ACTION_GAME_START = "game_start";
+    private static final String ACTION_GAME_STOP = "game_stop";
+    private static final String EXTRA_PACKAGE_NAME = "package_name";
+    private static final String KEY_GAMING_MODE_ACTIVE = "ax_gaming_mode_active";
+    private static final String KEY_POWER_MODE_PERF_BY_USER = "power_mode_perf_by_user";
+    private static final String KEY_POWER_MODE_PERF = "persist.sys.power_mode_perf";
+
+    private final Context mContext;
+    private final IActivityManager mActivityManager;
+    private final RemoteCallbackList<IGameSpaceCallback> mCallbacks = new RemoteCallbackList<>();
+
+    GameStateDispatcher(Context context) {
+        mContext = context;
+        mActivityManager = ActivityManager.getService();
+    }
+
+    void registerCallback(IGameSpaceCallback callback) {
+        mCallbacks.register(callback);
+    }
+
+    void unregisterCallback(IGameSpaceCallback callback) {
+        mCallbacks.unregister(callback);
+    }
+
+    void dispatchGameState(boolean active, String packageName) {
+        Settings.Secure.putIntForUser(mContext.getContentResolver(), KEY_GAMING_MODE_ACTIVE,
+                active ? 1 : 0, UserHandle.USER_CURRENT);
+        if (active && packageName == null) {
+            return;
+        }
+        // GameSpace registers a callback once its service is up. Until then, start
+        // that service with the event instead, so the first game is not missed.
+        if (!notifyCallbacks(active, packageName)) {
+            startGameSpaceService(active, packageName);
+        }
+    }
+
+    void boostGame(boolean enable) {
+        final int perfByUser = Settings.System.getIntForUser(mContext.getContentResolver(),
+                KEY_POWER_MODE_PERF_BY_USER, 0, UserHandle.USER_CURRENT);
+        if (perfByUser == 1) {
+            return;
+        }
+
+        Settings.System.putIntForUser(mContext.getContentResolver(), KEY_POWER_MODE_PERF,
+                enable ? 1 : 0, UserHandle.USER_CURRENT);
+        SystemProperties.set(KEY_POWER_MODE_PERF, enable ? "1" : "0");
+    }
+
+    private boolean notifyCallbacks(boolean active, String packageName) {
+        int delivered = 0;
+        final int count = mCallbacks.beginBroadcast();
+        try {
+            for (int i = 0; i < count; i++) {
+                final IGameSpaceCallback callback = mCallbacks.getBroadcastItem(i);
+                try {
+                    if (active) {
+                        callback.onGameStart(packageName);
+                    } else {
+                        callback.onGameLeave();
+                    }
+                    delivered++;
+                } catch (RemoteException e) {
+                    Slog.w(TAG, "Failed to notify GameSpace", e);
+                }
+            }
+        } finally {
+            mCallbacks.finishBroadcast();
+        }
+        return delivered > 0;
+    }
+
+    private void startGameSpaceService(boolean active, String packageName) {
+        final Intent intent = new Intent(active ? ACTION_GAME_START : ACTION_GAME_STOP)
+                .setComponent(GAME_SPACE_SERVICE_COMPONENT);
+        if (active) {
+            intent.putExtra(EXTRA_PACKAGE_NAME, packageName);
+        }
+        try {
+            final ComponentName result = mActivityManager.startService(null, intent, null, false,
+                    mContext.getOpPackageName(), mContext.getAttributionTag(),
+                    UserHandle.USER_CURRENT);
+            if (result == null) {
+                Slog.w(TAG, "GameSpace service not found");
+            }
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "Failed to start GameSpace service", e);
+        }
+    }
+}
