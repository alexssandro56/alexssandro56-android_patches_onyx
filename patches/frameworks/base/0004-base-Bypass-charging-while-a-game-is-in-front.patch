@@ -20,6 +20,8 @@ import android.app.IActivityManager;
 import android.content.ComponentName;
 import android.content.Context;
 import android.content.Intent;
+import android.database.ContentObserver;
+import android.os.Handler;
 import android.os.RemoteCallbackList;
 import android.os.RemoteException;
 import android.os.SystemProperties;
@@ -62,10 +64,20 @@ class GameStateDispatcher {
     private static final String PROP_SGSR_ENABLE = "persist.sys.sgsr.enable";
     private static final String PROP_SGSR_MODE = "persist.sys.sgsr.mode";
 
+    // Bypass charging: GameSpace's panel toggle and its settings switch. While a game
+    // is in front and either is on, init stops charging the battery and the phone
+    // runs from the charger (see onyx-extras' gamespace.rc).
+    private static final String[] KEYS_BYPASS_CHARGING = {
+        "mithermal_bypass_charging", "smart_battery_bypass_charging",
+    };
+    private static final String PROP_BYPASS_CHARGING = "sys.gamespace.bypass_charging";
+
     private final Context mContext;
     private final IActivityManager mActivityManager;
     private final RemoteCallbackList<IGameSpaceCallback> mCallbacks = new RemoteCallbackList<>();
 
+    private boolean mGameActive;
+
     GameStateDispatcher(Context context) {
         mContext = context;
         mActivityManager = ActivityManager.getService();
@@ -82,6 +94,8 @@ class GameStateDispatcher {
     void dispatchGameState(boolean active, String packageName) {
         // First, so the game's process sees it before it draws.
         stageAfme(active ? packageName : null);
+        mGameActive = active && packageName != null;
+        updateBypassCharging();
         Settings.Secure.putIntForUser(mContext.getContentResolver(), KEY_GAMING_MODE_ACTIVE,
                 active ? 1 : 0, UserHandle.USER_CURRENT);
         if (active && packageName == null) {
@@ -106,6 +120,33 @@ class GameStateDispatcher {
         SystemProperties.set(KEY_POWER_MODE_PERF, enable ? "1" : "0");
     }
 
+    /** Follows the bypass charging switches; {@code handler} serializes it with game events. */
+    void observeBypassCharging(Handler handler) {
+        final ContentObserver observer = new ContentObserver(handler) {
+            @Override
+            public void onChange(boolean selfChange) {
+                updateBypassCharging();
+            }
+        };
+        for (String key : KEYS_BYPASS_CHARGING) {
+            mContext.getContentResolver().registerContentObserver(
+                    Settings.System.getUriFor(key), false, observer, UserHandle.USER_ALL);
+        }
+    }
+
+    private void updateBypassCharging() {
+        boolean wanted = false;
+        for (String key : KEYS_BYPASS_CHARGING) {
+            wanted |= Settings.System.getIntForUser(mContext.getContentResolver(), key, 0,
+                    UserHandle.USER_CURRENT) == 1;
+        }
+        try {
+            SystemProperties.set(PROP_BYPASS_CHARGING, mGameActive && wanted ? "1" : "0");
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Failed to update bypass charging", e);
+        }
+    }
+
     /**
      * Applies the game's AFME settings and arms the layers for it, or disarms
      * them when {@code packageName} is null. A layer already loaded in a game
