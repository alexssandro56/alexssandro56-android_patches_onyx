                 mGameStateDispatcher.boostGame(mGameListManager.isGameInPerfMode(mCurrentGame));
diff --git a/services/core/java/com/android/server/wm/GameStateDispatcher.java b/services/core/java/com/android/server/wm/GameStateDispatcher.java
