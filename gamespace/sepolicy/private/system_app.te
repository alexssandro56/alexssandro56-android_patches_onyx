# GameSpace (com.ireddragonicy.gamespace) runs as system_app
allow system_app game_space_service:service_manager find;

# Per-game AFME settings and the mithermald profiles
set_prop(system_app, afme_prop)
set_prop(system_app, mithermal_prop)

# ThermalController drives mi_thermald's scene, boost, screen state and battery
# saver nodes (thermal_message, power_save)
r_dir_file(system_app, sysfs_thermal)
allow system_app sysfs_thermal:file w_file_perms;

# PerfTuner raises the CPU floor; the monitor reads the current frequencies
r_dir_file(system_app, sysfs_devices_system_cpu)
allow system_app sysfs_devices_system_cpu:file w_file_perms;
