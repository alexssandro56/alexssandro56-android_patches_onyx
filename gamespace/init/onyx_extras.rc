# GameSpace writes these as system; the device tree already hands over the
# rest of the nodes in ThermalNodes.kt
on boot
    chown system system /sys/class/thermal/thermal_message/screen_state
    chown system system /sys/module/migt/parameters/flt_preboost_enable
    chown system system /sys/module/migt/parameters/glk_disable
    chown system system /proc/sys/walt/sched_boost
    chown system system /sys/class/xm_power/charger/charger_thermal/wired_chg_curr
    chown system system /sys/class/xm_power/charger/charger_thermal/wired_chg_curr2
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy2/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy2/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy2/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy5/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy5/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy5/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_governor
    chown system system /sys/class/kgsl/kgsl-3d0/min_clock_mhz
    chmod 0664 /sys/class/kgsl/kgsl-3d0/min_clock_mhz
    chown system system /sys/class/kgsl/kgsl-3d0/max_clock_mhz
    chmod 0664 /sys/class/kgsl/kgsl-3d0/max_clock_mhz
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/governor
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/governor

# Bypass charging, set by GameSpaceService while a game is in front: stop
# charging the battery and run the phone from the charger.
on property:sys.gamespace.bypass_charging=1
    write /sys/class/xm_power/charger/smart_charge/smart_night 1

on property:sys.gamespace.bypass_charging=0
    write /sys/class/xm_power/charger/smart_charge/smart_night 0
